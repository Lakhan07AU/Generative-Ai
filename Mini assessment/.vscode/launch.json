{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (FastAPI :8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "GIT_PYTHON_GIT_EXECUTABLE": "${env:LOCALAPPDATA}\\miniproject-tools\\MinGit\\cmd\\git.exe",
        "OLLAMA_HOST": "http://127.0.0.1:11434"
      }
    },
    {
      "name": "Frontend (Streamlit :8501)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "frontend/app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "BACKEND_URL": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "Smoke test (end-to-end)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_test.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ],
  "compounds": [
    {
      "name": "Backend + Frontend",
      "configurations": ["Backend (FastAPI :8001)", "Frontend (Streamlit :8501)"],
      "stopAll": true
    }
  ]
}
