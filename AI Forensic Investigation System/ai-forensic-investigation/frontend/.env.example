# Backend API base URL used by the browser during development.
# Use 127.0.0.1 instead of localhost: on Windows, "localhost" resolves to
# IPv6 ::1 first, and the backend listens on IPv4 only, adding ~2s per request.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional alias for the REST API base (overrides NEXT_PUBLIC_API_URL).
# Set this to the PC's LAN address during physical-device tests, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://10.121.240.164:8443
# (HTTPS required for a phone's getUserMedia; the backend must then also run
# TLS - see PHYSICAL_CAMERA_SETUP.md. This var also drives wss:// signaling.)
# NEXT_PUBLIC_API_BASE_URL=

# Optional separate base origin for WebSocket channels (live signaling/status/
# detections/tracking/VLM). When unset, the WebSocket origin is derived from the
# API URL with http->ws / https->wss.
# NEXT_PUBLIC_WEBRTC_SIGNALING_URL=wss://10.121.240.164:8443