# ============================================================
# AI Forensic Investigation System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file containing secrets to git.
# ============================================================

# --- PostgreSQL ----------------------------------------------
POSTGRES_DB=forensics
POSTGRES_USER=forensics
POSTGRES_PASSWORD=forensics_password
DATABASE_URL=postgresql+psycopg2://forensics:forensics_password@postgres:5432/forensics

# --- MinIO (S3-compatible object storage) ---------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_VIDEOS=forensics-videos
MINIO_BUCKET_CLIPS=forensics-clips
MINIO_BUCKET_FRAMES=forensics-frames
MINIO_BUCKET_THUMBNAILS=forensics-thumbnails
MINIO_BUCKET_POLICIES=forensics-policies
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- JWT Authentication ---------------------------------------
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Backend --------------------------------------------------
# The image name used in docker-compose
BACKEND_IMAGE=ai-forensic-backend
# Path to local data volume mount
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Computer Vision ------------------------------------------
# YOLO model weights to download (Ultralytics YOLOv8n COCO)
YOLO_MODEL=yolov8n.pt

# --- Processing ------------------------------------------------
# Scene detection threshold (higher = fewer scene changes)
SCENE_SENSITIVITY=30.0
# Max clips to keep - fallback when PySceneDetect unavailable
MAX_CLIPS=50

# --- LLM (Part 2) ----------------------------------------------
# Provider: "simulation" (default, offline) or an OpenAI-compatible provider
# e.g. "openai", "ollama", "local". When set to a real provider, point
# LLM_BASE_URL at it and provide LLM_API_KEY if required.
LLM_PROVIDER=simulation
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Whisper (Part 2) ------------------------------------------
# "simulation" (default) for deterministic offline transcripts, otherwise a
# faster-whisper model id such as "tiny" / "base" / "small".
WHISPER_MODEL=simulation
WHISPER_LANGUAGE=en

# --- Qdrant (Part 2) -------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_EVIDENCE=video_evidence
QDRANT_COLLECTION_POLICY=policy_chunks
QDRANT_VECTOR_SIZE=384

# --- RAG (Part 2) ----------------------------------------------
RAG_TOP_K=10
RAG_RERANK_KEEP=5
RAG_VERIFICATION_THRESHOLD=0.5

